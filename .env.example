# Copy to .env and edit. Nothing here is a real credential.

# --- Django core ---------------------------------------------------------
# Leave DJANGO_DEBUG=true for local development. With DEBUG off, the app
# refuses to start unless DJANGO_SECRET_KEY is set.
DJANGO_DEBUG=true
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated absolute origins, e.g. https://shop.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=UTC

# --- Storage -------------------------------------------------------------
DJANGO_DB_PATH=db.sqlite3
DJANGO_MEDIA_ROOT=pictures

# --- HTTPS hardening (only read when DJANGO_DEBUG is off) ----------------
DJANGO_SECURE_COOKIES=true
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_HSTS_SECONDS=0

# --- Storefront ----------------------------------------------------------
STOREFRONT_PAGE_SIZE=12
STOREFRONT_CURRENCY_PREFIX="Rs. "
CART_MAX_QUANTITY_PER_LINE=99

# --- Product copywriter --------------------------------------------------
# "local" is deterministic and needs no network. "anthropic" calls the Claude
# API and falls back to "local" on any error or missing key.
COPYWRITER_BACKEND=local
COPYWRITER_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
